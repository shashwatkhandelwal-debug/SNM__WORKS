# SNM Works Environment Configuration Example

# Supabase Project Details
SUPABASE_URL=https://eayrmjmzjokeeuwazmjy.supabase.co
SUPABASE_KEY=sb_publishable_your_publishable_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_from_dashboard_settings_api

# Direct Postgres connection string using the snm_app role on port 5432 (not pooler 6543)
# Format: postgresql://snm_app:PASSWORD@db.eayrmjmzjokeeuwazmjy.supabase.co:5432/postgres
DATABASE_URL=postgresql://snm_app:REPLACE_WITH_SNM_APP_PASSWORD@db.eayrmjmzjokeeuwazmjy.supabase.co:5432/postgres

# Local Test DB credentials (used by local test harness on port 5433)
LOCAL_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/snm_test_db

# Test Supervisor credentials for Step 4 integration tests (real Supabase Auth user)
TEST_SUPERVISOR_EMAIL=REPLACE_WITH_TEST_SUPERVISOR_EMAIL
TEST_SUPERVISOR_PASSWORD=REPLACE_WITH_TEST_SUPERVISOR_PASSWORD

# Application settings
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_FOR_SESSION_SIGNING
ENCRYPTION_KEY=CHANGE_THIS_TO_A_FERNET_KEY

# LinkedIn OAuth Integration (standardized on port 8080)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8080/auth/linkedin/callback
LINKEDIN_COMPANY_PAGE_ID=

# Google Gemini API (Nano Banana 2 / Hybrid Marketing Images)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image